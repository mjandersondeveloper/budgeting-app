rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function isMember(householdId) {
      return signedIn()
        && exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid));
    }

    function validMonth(month) {
      return month.matches('^[0-9]{4}-(0[1-9]|1[0-2])$');
    }

    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /households/{householdId} {
      allow get: if isMember(householdId);
      allow list, create, update, delete: if false;

      match /members/{memberUid} {
        allow get, list: if isMember(householdId);
        allow create, update, delete: if false;
      }

      match /budgetConfig/{configId} {
        allow read: if configId == 'current' && isMember(householdId);
        allow update: if configId == 'current'
          && isMember(householdId)
          && request.resource.data.keys().hasOnly([
            'budgetTemplate',
            'customCategories',
            'categoryNameOverrides',
            'updatedAt'
          ])
          && request.resource.data.budgetTemplate is map
          && request.resource.data.customCategories is list
          && request.resource.data.customCategories.size() <= 200
          && request.resource.data.categoryNameOverrides is map
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }

      match /monthlyBudgets/{month} {
        allow read: if isMember(householdId);
        allow create, update: if isMember(householdId)
          && validMonth(month)
          && request.resource.data.keys().hasOnly(['amounts', 'updatedAt'])
          && request.resource.data.amounts is map
          && request.resource.data.amounts.size() <= 200
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }

      match /activities/{activityId} {
        allow read: if isMember(householdId);
        allow create, update: if isMember(householdId)
          && request.resource.data.keys().hasOnly([
            'id',
            'description',
            'amountCents',
            'categoryId',
            'date',
            'note',
            'updatedAt'
          ])
          && request.resource.data.id == activityId
          && request.resource.data.description is string
          && request.resource.data.description.size() > 0
          && request.resource.data.description.size() <= 100
          && request.resource.data.amountCents is int
          && request.resource.data.amountCents > 0
          && request.resource.data.categoryId is string
          && request.resource.data.date is string
          && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 300
          && request.resource.data.updatedAt == request.time;
        allow delete: if isMember(householdId);
      }
    }

    match /householdInvites/{inviteHash} {
      allow read, write: if false;
    }

    match /inviteRateLimits/{uid} {
      allow read, write: if false;
    }
  }
}
